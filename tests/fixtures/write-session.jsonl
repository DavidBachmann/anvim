1792449663803 {"type":"tool_field","id":"toolu_01WriteMadeLuaFixture000","name":"Write","key":"content","phase":"end","value":"-- Counts the words in a buffer.\nlocal M = {}\n\nlocal api = vim.api\n\n---@param buf integer\n---@return table<string, integer>\nfunction M.count(buf)\n  local counts = {}\n  for _, line in ipairs(api.nvim_buf_get_lines(buf, 0, -1, false)) do\n    for word in line:gmatch(\"%w+\") do\n      counts[word] = (counts[word] or 0) + 1\n    end\n  end\n  return counts\nend\n\n---@param counts table<string, integer>\n---@return string[]\nfunction M.top(counts, n)\n  local words = vim.tbl_keys(counts)\n  table.sort(words, function(a, b)\n    return counts[a] > counts[b]\n  end)\n  return vim.list_slice(words, 1, n)\nend\n\nreturn M\n"}

1792479341129 {"type":"text_delta","text":"im(s)\n  return ("}
1792479341149 {"type":"text_delta","text":"s:gsub(\"^%"}
1792479341169 {"type":"text_delta","text":"s+\", \"\"):gs"}
1792479341189 {"type":"text_delta","text":"ub(\"%s+$"}
1792479341210 {"type":"text_delta","text":"\", \"\"))\nend\n\nreturn"}

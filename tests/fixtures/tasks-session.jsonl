1792479340891 {"type":"text_delta","text":"im`. The"}
1792479340904 {"type":"text_delta","text":" function removes leading and trail"}
1792479340956 {"type":"text_delta","text":"ing whitespace from a"}
1792479340956 {"type":"text_delta","text":" string. It"}

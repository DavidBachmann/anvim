1792479341373 {"type":"text_delta","text":" first p"}
1792479341393 {"type":"text_delta","text":"ass"}
1792479341413 {"type":"text_delta","text":" to the start of"}
1792479341435 {"type":"text_delta","text":" the string, and `"}

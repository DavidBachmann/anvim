#!/bin/sh
# Usage: anvim [--model <model>] [--effort <level>] [--mode <mode>] [--no-sandbox] [--debug] [-c | --continue | -r | --resume [id]] [dir] [nvim args...]
# The permission mode is default, acceptEdits, plan or bypassPermissions. It is
# bypassPermissions unless --mode or ANVIM_MODE says otherwise: Claude runs
# tools without asking. The sandbox limits where its Bash commands write, and
# anvim's guards ask at the sandbox's gaps. Without a sandbox, anvim starts
# in default mode instead, unless you chose a mode. The effort is low, medium,
# high, xhigh or max. Without --effort or ANVIM_EFFORT it is the level in the
# Claude Code settings for the model, else the model's. Claude's Bash
# commands run in Claude Code's sandbox, which lets them write only in the
# project, a temp dir and the caches of npm, bun and go build.
# --no-sandbox (ANVIM_SANDBOX=0) turns it off. --debug (ANVIM_DEBUG=1) is for
# anvim's own development: it gives Claude a tool that takes a picture of the
# screen, and a tool that restarts anvim with the code on disk in the same
# session. When the repo's lockfiles changed since the last install, anvim
# runs scripts/install first. ANVIM_NO_INSTALL=1 skips that.
root=$(cd "$(dirname "$(realpath "$0")")/.." && pwd)

is_session_id() {
  case "$1" in
    ????????-????-????-????-????????????) return 0 ;;
    *) return 1 ;;
  esac
}

# Only flags resume a session, never a value inherited from another anvim.
unset ANVIM_CONTINUE ANVIM_RESUME
# Only the install of this start sets it.
unset ANVIM_INSTALL_FAILED

# Take anvim's own flags out of the arguments and keep the rest in order.
n=$#
while [ "$n" -gt 0 ]; do
  case "$1" in
    --model | --mode | --effort)
      # $# also counts the arguments already moved to the end.
      if [ "$n" -lt 2 ]; then
        echo "anvim: $1 needs a value, e.g. --model haiku, --effort high or --mode default" >&2
        exit 2
      fi
      case $1 in
        --model) ANVIM_MODEL=$2 ;;
        --mode) ANVIM_MODE=$2 mode=1 ;;
        *) ANVIM_EFFORT=$2 effort=1 ;;
      esac
      shift 2
      n=$((n - 2))
      ;;
    --model=*)
      ANVIM_MODEL=${1#--model=}
      shift
      n=$((n - 1))
      ;;
    --effort=*)
      ANVIM_EFFORT=${1#--effort=} effort=1
      shift
      n=$((n - 1))
      ;;
    --mode=*)
      ANVIM_MODE=${1#--mode=} mode=1
      shift
      n=$((n - 1))
      ;;
    --no-sandbox)
      ANVIM_SANDBOX=0
      shift
      n=$((n - 1))
      ;;
    --debug)
      ANVIM_DEBUG=1
      shift
      n=$((n - 1))
      ;;
    -c | --continue)
      ANVIM_CONTINUE=1
      shift
      n=$((n - 1))
      ;;
    # Without a session id, anvim opens the session picker.
    -r | --resume)
      ANVIM_RESUME=pick
      shift
      n=$((n - 1))
      if [ "$n" -gt 0 ] && is_session_id "$1"; then
        ANVIM_RESUME=$1
        shift
        n=$((n - 1))
      fi
      ;;
    --resume=*)
      ANVIM_RESUME=${1#--resume=}
      shift
      n=$((n - 1))
      ;;
    *)
      set -- "$@" "$1"
      shift
      n=$((n - 1))
      ;;
  esac
done
[ -n "$ANVIM_MODEL" ] && export ANVIM_MODEL
[ -n "$ANVIM_SANDBOX" ] && export ANVIM_SANDBOX
[ -n "$ANVIM_DEBUG" ] && export ANVIM_DEBUG
if [ -n "$mode" ] || [ -n "$ANVIM_MODE" ]; then
  case "$ANVIM_MODE" in
    default | acceptEdits | plan | bypassPermissions) export ANVIM_MODE ;;
    *)
      echo "anvim: --mode must be default, acceptEdits, plan or bypassPermissions" >&2
      exit 2
      ;;
  esac
fi
if [ -n "$effort" ] || [ -n "$ANVIM_EFFORT" ]; then
  case "$ANVIM_EFFORT" in
    low | medium | high | xhigh | max) export ANVIM_EFFORT ;;
    *)
      echo "anvim: --effort must be low, medium, high, xhigh or max" >&2
      exit 2
      ;;
  esac
fi
if [ -n "$ANVIM_CONTINUE" ] && [ -n "$ANVIM_RESUME" ]; then
  echo "anvim: use --continue or --resume, not both" >&2
  exit 2
fi
[ -n "$ANVIM_CONTINUE" ] && export ANVIM_CONTINUE
[ -n "$ANVIM_RESUME" ] && export ANVIM_RESUME

# The cd below would change what a relative dir names.
case $ANVIM_INSTALL_DIR in
  '' | /*) ;;
  *) export ANVIM_INSTALL_DIR="$PWD/$ANVIM_INSTALL_DIR" ;;
esac

# The install's output goes to stderr, because with --embed stdout is the RPC
# channel.
if [ "$ANVIM_NO_INSTALL" != 1 ]; then
  # stdpath("data") under NVIM_APPNAME=anvim.
  install=${ANVIM_INSTALL_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/anvim}
  export ANVIM_INSTALL_DIR="$install"
  if ! "$root/scripts/install" --check; then
    echo "anvim: installing what this checkout needs into $install" >&2
    if ! "$root/scripts/install" </dev/null >&2; then
      # The install's last line can lack its newline.
      echo >&2
      if [ ! -e "$install/stamp" ]; then
        echo "anvim: the install failed" >&2
        exit 1
      fi
      echo "anvim: the install failed, so anvim starts with the earlier install, and tries again next time" >&2
      # The TUI's alternate screen hides these lines, so anvim warns again.
      export ANVIM_INSTALL_FAILED=1
    fi
  fi
fi

if [ -d "$1" ]; then
  cd "$1" || exit 1
  shift
fi
NVIM_APPNAME=anvim exec nvim -u "$root/init.lua" "$@"
